    }
}

Form{
    .Id = "Key_Preference_Form"
    .Output = "Key_Preference"
    Group{
        .Title = "按键设置"
        KeyBind{
            .Id = "Fire"
            .Enabled = true
            .Description = "开火"
            .SubDescription = "绑定开火按键"
            .Command = "+_attack"

            .Bind("mouse1")
        }
        MustField{
            .Id = "MouseX"
            .Enabled = true
            .Description = "鼠标X轴"
            .SubDescription = "绑定鼠标X轴"
            .Command = "\"MouseMode;yaw\""

            .Bind("mouse_x")
        }
        KeyBind{
            .Id = "select_map1"
            .Enabled = true
            .Description = "轮盘键"
            .SubDescription = "呼出轮盘"
            .Command = "+select_map1"

            .Bind("x")
        }
        KeyBind{
            .Id = "chushihua"
            .Enabled = true
            .Description = "初始化键"
            .SubDescription = "换图后初始化"
            .Command = "chushihua"

            .Bind("z")
        }
        KeyBind{
            .Id = "ChangeTeam"
            .Enabled = true
            .Description = "更改阵营"
            .SubDescription = "不好使可按两下"
            .Command = "ChangeTeam"

            .Bind("f1")
        }
        KeyBind{
            .Id = "AutoThrowOne_q"
            .Enabled = true
            .Description = "道具投掷与身法启动"
            .SubDescription = "道具投掷、身法启动键"
            .Command = "+AutoThrowOne_q"

            .Bind("t")
        }
        KeyBind{
            .Id = "NoRecoil"
            .Enabled = true
            .Description = "自动压枪开关"
            .SubDescription = "仅管控鼠标左键"
            .Command = "NoRecoil"

            .Bind("j")
        }
        KeyBind{
            .Id = "If_JumpThrow"
            .Enabled = true
            .Description = "跳投键"
            .SubDescription = "执行跳投"
            .Command = "+If_JumpThrow"

            .Bind("l")
        }
        KeyBind{
            .Id = "If_WJumpThrow"
            .Enabled = true
            .Description = "前跳投键"
            .SubDescription = "执行前跳投"
            .Command = "+If_WJumpThrow"

            .Bind("p")
        }
        KeyBind{
            .Id = "FastHandgun"
            .Enabled = true
            .Description = "手枪速射开关"
            .SubDescription = "开启或关闭手枪快速开火"
            .Command = "FastHandgun"

            .Bind("o")
        }
        
        
    }
    Group{
        .Title = "基础移动控制"
        KeyBind{
            .Id = "Forward1Once"
            .Enabled = true
            .Description = "前进"
            .SubDescription = "向前移动"
            .Command = "+forward1Once"

            .Bind("w")
        }
        KeyBind{
            .Id = "Back1Once"
            .Enabled = true
            .Description = "后退"
            .SubDescription = "向后移动"
            .Command = "+back1Once"

            .Bind("s")
        }
        KeyBind{
            .Id = "Left1Once"
            .Enabled = true
            .Description = "左移"
            .SubDescription = "向左移动"
            .Command = "+left1Once"

            .Bind("a")
        }
        KeyBind{
            .Id = "Right1Once"
            .Enabled = true
            .Description = "右移"
            .SubDescription = "向右移动"
            .Command = "+right1Once"

            .Bind("d")
        }
        KeyBind{
            .Id = "If_Jump"
            .Enabled = true
            .Description = "跳跃"
            .SubDescription = "跳跃键"
            .Command = "+If_jump"

            .Bind("space")
        }
        KeyBind{
            .Id = "HuifuButton1"
            .Enabled = true
            .Description = "急停开关键"
            .SubDescription = "可不绑定"
            .Command = "+huifuButton1"

            .Bind("v")
        }
        KeyBind{
            .Id = "Sprint_Stick"
            .Enabled = true
            .Description = "静步贴墙"
            .SubDescription = "可不绑定"
            .Command = "+_sprint"

            .Bind("shift")
        }
        KeyBind{
            .Id = "Duck"
            .Enabled = true
            .Description = "下蹲"
            .SubDescription = "蹲键"
            .Command = "+_duck"

            .Bind("ctrl")
        }
        KeyBind{
            .Id = "Sprint_Plus"
            .Enabled = true
            .Description = "加速静步"
            .SubDescription = "加速静步绑定键位"
            .Command = "+Sprint_Plus"

            .Bind("mouse5")
        }
        KeyBind{
            .Id = "If_JumpBug"
            .Enabled = true
            .Description = "大跳键"
            .SubDescription = "大跳功能键位"
            .Command = "+If_JumpBug"

            .Bind("k")
        }
    }
    Group{
        .Title = "测试中"
        KeyBind{
            .Id = "antiFlash"
            .Enabled = true
            .Description = "180度反闪"
            .SubDescription = "测试中"
            .Command = "+antiFlash"

            .Bind("None")
        }
    }
    Group{
        .Title = "主按键"
        KeyBind{
            .Id = "Weapon1"
            .Enabled = true
            .Description = "主武器"
            .SubDescription = "切换主武器"
            .Command = "\"slot1;DelayDetectWeapon1\""

            .Bind("1")
        }
        KeyBind{
            .Id = "Weapon2"
            .Enabled = true
            .Description = "副武器"
            .SubDescription = "切换副武器"
            .Command = "\"slot2;DelayDetectWeapon2\""

            .Bind("2")
        }
        KeyBind{
            .Id = "Weapon3"
            .Enabled = true
            .Description = "切刀"
            .SubDescription = "切换刀"
