    Group{
        .Title = "滚轮跳"
        OptionField{
            .Id = "Func_001"
            .Enabled = true
            .Description = "滚轮跳（上滚轮）"
            .SubDescription = "开启上滚轮跳"
            Options{
                Option{
                    .Id = "Option_001"
                    .Description = "开启"
                    .Command = "bind \"MWHEELUP\" \"+_jump\""
                }
                Option{
                    .Id = "Option_002"
                    .Description = "关闭"
                    .Command = "bind \"None\" \"+_jump\""
                }
            }
            .Selected = "Option_002"
        }
        OptionField{
            .Id = "Func_002"
            .Enabled = true
