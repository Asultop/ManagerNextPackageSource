@Name: BiShip V1
@Version: V1
@Author: Yuhan
@Target: biship
@Description: Yuhan BiShip CS2 键位配置包

Form{
    .Id = "config"
    .Output = "config"
    .Description = "BiShip 配置"
    Group{
        .Title = "绑定"
        TextField{
            .Id = using_joystick
            .Description = "player0_using_joystick"
            .Text = "player0_using_joystick 0"
            .Command = "${$(using_joystick).Text}"
        }
    }
    Group{
        .Title = "个人设置"
        LineField{
            .Id = "lineField_m_yaw"
            .Description = "水平灵敏度"
            .SubDescription = "m_yaw 设置"
            .Args{
                .Arg{
                    .Id = "m_yaw"
                    .Description = "m_yaw"
                    .Value = "0.022"
                }
            }
            .Expression = "alias default.m_yaw m_yaw ${$(m_yaw).Value}"
        }
        LineField{
            .Id = "lineField_m_pitch"
            .Description = "垂直灵敏度"
            .SubDescription = "m_pitch 设置"
            .Args{
                .Arg{
                    .Id = "m_pitch"
                    .Description = "m_pitch"
                    .Value = "0.022"
                }
            }
            .Expression = "alias default.m_pitch m_pitch ${$(m_pitch).Value}"
        }
        LineField{
            .Id = "lineField_sensitivity"
            .Description = "灵敏度"
            .SubDescription = "sensitivity 设置"
            .Args{
                .Arg{
                    .Id = "sensitivity"
                    .Description = "sensitivity"
                    .Value = "2.5"
                }
            }
            .Expression = "alias default.sensitivity sensitivity ${$(sensitivity).Value}"
        }
        LineField{
            .Id = "lineField_sensitivity_y_scale"
            .Description = "y 收缩度设置"
            .SubDescription = "sensitivity_y_scale 设置"
            .Args{
                .Arg{
                    .Id = "sensitivity_y_scale"
                    .Description = "sensitivity_y_scale"
                    .Value = "1.0"
                }
            }
            .Expression = "alias default.sensitivity_y sensitivity_y_scale ${$(sensitivity_y_scale).Value}"
        }
        LineField{
            .Id = "lineField_cl_radialmenu_deadzone_size"
            .Description = "径向菜单死区大小设置"
            .SubDescription = "cl_radialmenu_deadzone_size 设置"
            .Args{
                .Arg{
                    .Id = "cl_radialmenu_deadzone_size"
                    .Description = "cl_radialmenu_deadzone_size"
                    .Value = "0.4"
                }
            }
            .Expression = "alias default.cl_radialmenu_deadzone_size cl_radialmenu_deadzone_size ${$(cl_radialmenu_deadzone_size).Value}"
        }
        LineField{
            .Id = "lineField_cl_quickinventory_filename"
            .Description = "客户端快速背包文件名"
            .SubDescription = "cl_quickinventory_filename 设置"
            .Args{
                .Arg{
                    .Id = "cl_quickinventory_filename"
                    .Description = "cl_quickinventory_filename"
                    .Value = "cfg/biship/quickinv/any.txt"
                }
            }
            .Expression = "alias default.cl_quickinventory_filename cl_quickinventory_filename ${$(cl_quickinventory_filename).Value}"

        }
        TextField{
            .Id = "TextField_applySettings"
            .Description = "应用设置"
            .SubDescription = "应用上述设置"
            .Text = "已自动应用"
            .Command = "default.m_yaw\ndefault.m_pitch\ndefault.sensitivity\ndefault.sensitivity_y\n"
        }
    }
    Group{
        .Title = "快捷指令"


        // alias .a exec biship/app
        OptionField{
            .Id = "biship_app"
            .Description = "开启 biship/app 快捷指令"
            Options{
                Option{
                    .Id = "on"
                    .Description = "开启"
                }
                Option{
                    .Id = "off"
                    .Description = "关闭"
                }
            }
            .Selected = "on"
        }
        LineField{
            .Id = "lineField_biship_app"
            .Description = "biship/app 快捷指令"
            .SubDescription = "绑定 biship/app "
            .Enabled = $(biship_app).Selected == "on" ? true : false
            .Args{
                .Arg{
                    .Id = "bindKey_biship_app"
                    .Description = "绑定键位"
                    .Value = ".a"
                }
            }
            .Expression = "alias ${$(bindKey_biship_app).Value} biship/app"
        }

