                    .Id = "off"
                    .Description = "关闭"
                }
            }
            .Selected = "on"
        }
        LineField{
            .Id = "lineField_alias_y"
            .Description = "alias y internal_confirm 快捷指令"
            .SubDescription = "绑定 键位"
            .Enabled = $(alias_y).Selected == "on" ? true : false
            .Args{
                .Arg{
                    .Id = "bindKey_alias_y"
                    .Description = "绑定键位"
                    .Value = "y"
                }
            }
            .Expression = "alias ${$(bindKey_alias_y).Value} internal_confirm"
        }

        // alias n internal_cancel
        OptionField{
            .Id = "alias_n"
            .Description = "开启 alias n internal_cancel 快捷指令"
            Options{
                Option{
                    .Id = "on"
                    .Description = "开启"
                }
                Option{
                    .Id = "off"
                    .Description = "关闭"
                }
            }
            .Selected = "on"
        }
        LineField{
            .Id = "lineField_alias_n"
            .Description = "alias n internal_cancel 快捷指令"
            .SubDescription = "绑定 键位"
            .Enabled = $(alias_n).Selected == "on" ? true : false
            .Args{
                .Arg{
                    .Id = "bindKey_alias_n"
                    .Description = "绑定键位"
                    .Value = "n"
                }
            }
            .Expression = "alias ${$(bindKey_alias_n).Value} internal_cancel"
        }
        
        TextField{
            .Id = "TextField_applySettings_3"
            .Description = "应用设置"
            .SubDescription = "应用上述设置"
            .Text = "已自动应用"
            .Command = "exec biship/localized/biship\nexec biship/localized/tchinese\nexec biship/theme/biship\n"
        }
        
        
    }
}